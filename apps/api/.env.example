# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolvex

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Freshworks (Track 1)
FRESHWORKS_DOMAIN=your-domain.freshworks.com
FRESHWORKS_API_KEY=your-api-key
FRESHWORKS_AGENT_STUDIO_URL=https://your-domain.freshworks.com/agent-studio

# ElevenLabs
ELEVENLABS_API_KEY=your-api-key
ELEVENLABS_AGENT_ID=your-agent-id

# Demo
DEMO_MODE=true